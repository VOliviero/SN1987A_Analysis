Cell["Profile likelihood of the absolute time T1B=T1I-ti+tb", "Subsection",
 CellChangeTimes->{{3.9714278599594994`*^9, 
  3.971427892332917*^9}},ExpressionUUID->"039f91c5-f4c7-4b55-a5f6-\
aa4e3ccd0c00"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "T0B", " ", "is", " ", "the", " ", "absolute", " ", "time", " ", "of", 
      " ", "arrival", " ", "of", " ", "the", " ", "first", " ", "neutrino", 
      " ", "in", " ", "Baksan", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
        "corresponding", " ", "to", " ", "0", " ", "time", " ", "in", " ", 
         "the", " ", "flux"}], ")"}], ".", " ", "For"}], " ", "a", " ", 
      "point"}], "-", 
     RowBox[{"like", " ", "Earth", " ", "T0B"}]}], "=", "T0I"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "T1B", " ", "is", " ", "the", " ", "absolute", " ", "time", " ", "of", " ",
     "detection", " ", "of", " ", "the", " ", "first", " ", "neutrino", " ", 
    "in", " ", "Baksan"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"T1B", "=", 
     RowBox[{"T0B", "+", "tb"}]}], ",", " ", 
    RowBox[{
    "where", " ", "tb", " ", "is", " ", "the", " ", "delay", " ", "time", " ",
      "for", " ", "IMB"}]}], "*)"}]}]], "Input",
