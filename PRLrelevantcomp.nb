Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
     "T0KK", " ", "is", " ", "the", " ", "absolute", " ", "time", " ", "of", 
      " ", "arrival", " ", "of", " ", "the", " ", "first", " ", "neutrino", 
      " ", "in", " ", "KK", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
        "corresponding", " ", "to", " ", "0", " ", "time", " ", "in", " ", 
         "the", " ", "flux"}], ")"}], ".", " ", "For"}], " ", "a", " ", 
      "point"}], "-", 
     RowBox[{"like", " ", "Earth", " ", "T0I"}]}], "=", "T0KK"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "T1KK", " ", "is", " ", "the", " ", "absolute", " ", "time", " ", "of", 
    " ", "detection", " ", "of", " ", "the", " ", "first", " ", "neutrino", 
    " ", "in", " ", "KK"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"T1KK", "=", 
     RowBox[{"T0KK", "+", "tk"}]}], ",", " ", 
    RowBox[{
    "where", " ", "tk", " ", "is", " ", "the", " ", "delay", " ", "time", " ",
      "for", " ", "IMB"}]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9487805818728714`*^9, 3.9487806123764863`*^9}, {
