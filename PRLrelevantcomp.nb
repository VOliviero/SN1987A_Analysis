Cell[CellGroupData[{

Cell["Profile likelihood of the absolute time T1K=T1I-ti+tk", "Subsection",
 CellChangeTimes->{{3.9714277950831757`*^9, 
  3.9714278161872845`*^9}},ExpressionUUID->"a8fdffb0-7b96-4b06-97b4-\
