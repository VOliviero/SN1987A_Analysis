Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FcalligraphicA", "[", 
    RowBox[{"t_", ",", "t0_", ",", "a_"}], "]"}], ":=", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox[
      RowBox[{"1", "+", 
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["t0", "a"], ")"}], "2"]}]}], 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"2", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox["t", "a"], ")"}], "2"], "-", 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox["t0", "a"], ")"}], "2"]}], ")"}]}], "]"}], "+", 
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["t0", "a"], ")"}], "2"], 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["t0", "t"], ")"}], "2"]}]}]], ")"}], 
    FractionBox["1", "2"]]}], ";"}]], "Input",
 CellChangeTimes->{{3.9033435159292493`*^9, 3.9033435220818753`*^9}, {
